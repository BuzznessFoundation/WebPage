{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "redirects": [
        {
            "source": "/:path*",
            "has": [{ "type": "host", "value": "www\\.buzzness\\.cl" }],
            "destination": "https://buzzness.cl/:path*",
            "permanent": true
        }
    ],
    "routes": [
        { "handle": "filesystem" },
        { "src": "/.*", "status": 404, "dest": "/404.html" }
    ]
}
